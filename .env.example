# Copy this file to .env for local work. Never commit the real .env.
# Atlas URI. Use your database user, cluster address, and the portfolio_blog database.
MONGO_URI=mongodb+srv://portfolio_app:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/portfolio_blog?retryWrites=true&w=majority

# Local port. The hosting service supplies its own PORT value.
PORT=3000

# A long random signing secret (at least 32 characters). Keep it private.
JWT_SECRET=YOUR_RANDOM_SECRET

# Exact front-end origin, no trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# 0 for a direct local connection; 1 behind the single hosting proxy.
TRUST_PROXY=0

# development locally; production on the hosting service.
NODE_ENV=development
